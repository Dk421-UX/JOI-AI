# ==============================================================================
# JOI AI — Environment Configuration Example
# Copy this file to .env or backend/.env and provide your credentials.
# ==============================================================================

# ── [SERVER-SIDE PRIVATE SECRETS] (NEVER expose to client browser) ────────────

# 1. Groq AI API Key (Required for conversation reasoning & nickname generation)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Selection (Optional, defaults to llama-3.3-70b-versatile)
# Supported: llama-3.3-70b-versatile, llama-3.1-70b-versatile, qwen/qwen3.8-27b
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Neon PostgreSQL Database URL (Authoritative Persistence Layer)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# Get a database at: https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── [SERVER CONFIGURATION] ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
